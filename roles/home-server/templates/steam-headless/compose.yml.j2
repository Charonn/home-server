---
services:
  steam-headless:
    image: josh5/steam-headless:{{ steam_headless_version }}
    container_name: steam-headless
    restart: unless-stopped
    shm_size: "2g"
    ipc: host
    ulimits:
      nofile:
        soft: 1024
        hard: 524288
    cap_add:
      - NET_ADMIN
      - SYS_ADMIN
      - SYS_NICE
    security_opt:
      - seccomp:unconfined
      - apparmor:unconfined

    # GPU PASSTHROUGH:
    # Docker-in-LXC path: the nvidia container runtime cannot work inside this
    # LXC (no host driver libraries to inject), so the container installs its
    # own NVIDIA userspace (NVIDIA_DRIVER_VERSION empty = auto-match host)
    # and we map the device nodes explicitly. /dev/dri is required for
    # Sunshine kmsgrab capture and for OpenGL/Vulkan.
    network_mode: host
    hostname: {{ steam_headless_hostname }}
    extra_hosts:
      - "{{ steam_headless_hostname }}:127.0.0.1"

    # SECRETS:
    # USER_PASSWORD and SUNSHINE_PASS are injected via steam-headless.env
    # (mode 0600, rendered next to this compose.yml by the env-file task in
    # tasks/steam-headless.yml, no_log) - the only plaintext copy on disk.
    # Service-level env_file: the tailscale sidecar receives no secrets from
    # THIS file - its own TS_AUTHKEY lives in steam-headless-ts.env (see the
    # ts-steam-headless service below).
    env_file:
      - steam-headless.env

    # ENVIRONMENT:
    environment:
      # System
      - TZ={{ steam_headless_timezone }}
      - USER_LOCALES={{ steam_headless_locales }}
      - DISPLAY={{ steam_headless_display }}
      # User
      - PUID=1000
      - PGID=1000
      - UMASK=000
      # Mode
      - MODE=primary
      # Web UI (noVNC on http://<host>:{{ steam_headless_novnc_port }})
      - WEB_UI_MODE=vnc
      - ENABLE_VNC_AUDIO=true
      - PORT_NOVNC_WEB={{ steam_headless_novnc_port }}
      - NEKO_NAT1TO1=
      # Steam
      - ENABLE_STEAM=true
      - STEAM_ARGS={{ steam_headless_steam_args }}
      # Sunshine (Moonlight server)
      - ENABLE_SUNSHINE=true
      - SUNSHINE_USER={{ steam_headless_sunshine_user }}
      # Xorg (no monitor attached to the LXC - use dummy video config)
      - ENABLE_EVDEV_INPUTS=true
      - FORCE_X11_DUMMY_CONFIG=true
      # Nvidia specific config
      # NVIDIA_DRIVER_VERSION forces the userspace install (the container has
      # no nvidia-smi to auto-detect; toolkit injection cannot work in LXC)
      - NVIDIA_DRIVER_CAPABILITIES=all
      - NVIDIA_VISIBLE_DEVICES=all
      - NVIDIA_DRIVER_VERSION={{ steam_headless_nvidia_driver_version }}
      # keylase patch: enables NvFBC capture (required for headless NVIDIA)
      - NVIDIA_PATCH_VERSION={{ steam_headless_nvidia_patch_version }}

    # DEVICES:
    devices:
      # Use the host fuse device [REQUIRED].
      - /dev/fuse
      # Add the host uinput device [REQUIRED] (Sunshine virtual input).
      - /dev/uinput
      # NVIDIA device nodes (present in the LXC via passthrough)
      # /dev/nvidia-modeset is created by the repair task / nvidia-modeset-device
      # service on the host - required by libnvidia-fbc (NvFBC capture)
      - /dev/nvidia0
      - /dev/nvidiactl
      - /dev/nvidia-uvm
      - /dev/nvidia-uvm-tools
      - /dev/nvidia-modeset
      # DRM/KMS nodes (NVIDIA card + render node, mounted by-path) - required
      # for Sunshine kmsgrab capture. Without these, no encoder works.
      - /dev/dri/card0
      - /dev/dri/renderD129
    # Ensure container access to input event devices 13:*
    device_cgroup_rules:
      - 'c 13:* rmw'

    # VOLUMES:
    volumes:
      # The location of your home directory.
      # NOTE: also acts as the NVIDIA driver download cache: on container
      # recreation the entrypoint reuses ~/Downloads/NVIDIA_<host-version>.run
      # (only re-downloads when the Proxmox host driver version changes) and
      # reinstalls the userspace libs into the container (~1 min).
      - {{ steam_headless_host_path }}/home/:/home/default/:rw

      # The location where all games should be installed.
      # This path needs to be set as a library path in Steam after logging in.
      - {{ steam_headless_host_path }}/games/:/mnt/games/:rw

      # The Xorg socket.
      - {{ steam_headless_host_path }}/sockets/.X11-unix/:/tmp/.X11-unix/:rw

      # Pulse audio socket.
      - {{ steam_headless_host_path }}/sockets/pulse/:/tmp/pulse/:rw

      # Physical input devices (Docker-in-LXC robustness; Xorg device detection
      # and Sunshine virtual input). NOTE: do NOT mount /run/udev/data here -
      # dumb-udev chmods/creates it itself and a read-only mount crashes it.
      - /dev/input/:/dev/input/:rw
      # Patched input-sync helper: prevents the Xorg restart crash loop
      # (upstream issue #231)
      - {{ steam_headless_host_path }}/overrides/start-dumb-udev.sh:/usr/bin/start-dumb-udev.sh:ro

  ts-steam-headless:
    # Tailscale sidecar giving the Steam Headless web UI its own MagicDNS
    # name (https://steam-headless.<tailnet>.ts.net).
    # NOTE: cannot share the steam-headless network namespace (host network),
    # so it runs on its own bridge network and proxies to the host port via
    # host.docker.internal. Moonlight/Sunshine streaming always connects to
    # the LXC directly (UDP cannot be proxied by tailscale serve).
    image: tailscale/tailscale:v1.96.5
    container_name: ts-steam-headless
    restart: unless-stopped
    # TS_AUTHKEY is injected via steam-headless-ts.env (mode 0600, rendered
    # next to this compose.yml by the env-file task in tasks/steam-headless.yml,
    # no_log) - the only plaintext copy on disk (env-file/no_log contract,
    # analog steam-headless.env, PR #16/#17).
    # Service-level env_file: the sidecar receives ONLY the Tailscale key.
    env_file:
      - steam-headless-ts.env
    environment:
      TS_EXTRA_ARGS: "--hostname=steam-headless"
      TS_SERVE_CONFIG: "/config/config.json"
      TS_STATE_DIR: "/var/lib/tailscale"
      TS_USERSPACE: "true"
    volumes:
      - "{{ steam_headless_host_path }}/tailscale/state:/var/lib/tailscale"
      - "{{ steam_headless_host_path }}/tailscale/config:/config"
    extra_hosts:
      - "host.docker.internal:host-gateway"