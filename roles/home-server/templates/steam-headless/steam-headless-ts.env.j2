# Managed by Ansible (role: home-server, steam-headless stack) — DO NOT EDIT.
#
# TS_AUTHKEY is injected by Ansible at deploy time into THIS file (mode 0600,
# same directory as the rendered compose.yml) — the only plaintext copy — and
# the rendered compose.yml consumes it via the ts-steam-headless service's
# `env_file:` (env-file/no_log contract, analog steam-headless.env, PR
# #16/#17). Separate file, NOT appended to steam-headless.env: the Tailscale
# sidecar receives ONLY the authkey, no steam stack secrets (least privilege).
# Never commit a deployed instance, never print/echo its content; the render
# task carries no_log: true.
TS_AUTHKEY={{ tailscale_auth_key_vault }}