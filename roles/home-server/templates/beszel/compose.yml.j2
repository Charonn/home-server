---
services:
  ts-beszel-hub:
    image: tailscale/tailscale:latest
    container_name: ts-beszel-hub
    restart: unless-stopped
    environment:
      TS_AUTHKEY: "{{ tailscale_beszel_auth_key }}"
      TS_EXTRA_ARGS: "--hostname=beszel --advertise-tags=tag:beszel"
      TS_SERVE_CONFIG: "/config/config.json"
      TS_STATE_DIR: "/var/lib/tailscale"
      TS_USERSPACE: "true"
    volumes:
      - "{{ beszel_host_path }}/tailscale/state:/var/lib/tailscale"
      - "{{ beszel_host_path }}/tailscale/config:/config"
    network_mode: service:beszel
  beszel:
    image: henrygd/beszel:latest
    container_name: beszel
    restart: unless-stopped
    volumes:
      - "{{ beszel_host_path }}/beszel_data:/beszel_data"
      - "{{ beszel_host_path }}/beszel_socket:/beszel_socket"
