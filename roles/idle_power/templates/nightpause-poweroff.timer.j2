[Unit]
# Managed by Ansible (idle_power.yml) — DO NOT EDIT
Description=Idle-power nightpause timer (power off at {{ idle_power_nightpause_off }})

[Timer]
OnCalendar=*-*-* {{ idle_power_nightpause_off }}:00
Persistent=false
RandomizedDelaySec=0
Unit=nightpause-poweroff.service

[Install]
WantedBy=timers.target