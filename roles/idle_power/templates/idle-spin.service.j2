[Unit]
# Managed by Ansible (idle_power) - DO NOT EDIT
Description=Apply HDD spin-down policy after boot (idle-power)
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Fixup.md Phase 9b (2026-10-27): beim Boot+37 s war die WD20EARS noch nicht
# enumeriert -> hdparm 'No such file or directory', Unit blieb dauerhaft
# 'failed'. Fail-soft: bei Fehlschlag 15 s später erneut probieren statt
# failed stehen zu bleiben (die Platte taucht i.d.R. Sekunden später auf).
Restart=on-failure
RestartSec=15
{% for it in idle_power_spin_items | default([]) %}
{% if it.spin_code | int == 0 %}
ExecStart=/usr/sbin/hdparm -q -B {{ idle_power_spin_apm }} -S 0 {{ it.dev }}
{% else %}
ExecStart=/usr/sbin/hdparm -q -B {{ idle_power_spin_apm }} -S {{ it.spin_code }} {{ it.dev }}
{% endif %}
{% endfor %}
[Install]
WantedBy=multi-user.target
