#!/usr/bin/env python3
# Managed by ansible (role steam) — installed as /usr/local/bin/cuda-check.
# Semantics identical to the compiled helper on live CT 110, implemented via
# ctypes (no ELF shipping, no gcc needed in the CT):
#   exit 0          -> CUDA usable (cuInit + cuDeviceGetCount succeed)
#   exit 1 + reason -> unusable (libcuda missing / symbols missing / runtime err)
# sunshine-setup.sh keys the nvenc<->software encoder flip on this exit code.
import ctypes
import sys

LIBCUDA_PATHS = (
    "libcuda.so.1",
    "/usr/lib/x86_64-linux-gnu/libcuda.so.1",
    "/usr/lib/x86_64-linux-gnu/nvidia/current/libcuda.so.1",
)


def main() -> int:
    lib = None
    for path in LIBCUDA_PATHS:
        try:
            lib = ctypes.CDLL(path)
            break
        except OSError:
            continue
    if lib is None:
        print("FAIL: cannot dlopen libcuda.so.1: %s" % sys.exc_info()[1])
        return 1

    try:
        rc = lib.cuInit(0)
    except AttributeError:
        # RTLD_LOCAL keeps the error message generic (same as the C version)
        print("FAIL: libcuda.so.1 missing symbols (driver userspace broken?)")
        return 1
    if rc != 0:
        print("FAIL: cuInit returned %d (999 = CUDA_ERROR_UNKNOWN: usually "
              "/dev/nvidia-uvm blocked by the LXC device ACL)" % rc)
        return rc if rc != 0 else 1

    count = ctypes.c_int(0)
    rc = lib.cuDeviceGetCount(ctypes.byref(count))
    if rc != 0:
        print("FAIL: cuDeviceGetCount returned %d" % rc)
        return rc if rc != 0 else 1
    print("OK: cuInit succeeded, %d CUDA device(s) visible" % count.value)
    return 0


if __name__ == "__main__":
    sys.exit(main())