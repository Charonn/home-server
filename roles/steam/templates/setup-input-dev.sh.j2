#!/bin/bash
# Managed by ansible (role steam) — verbatim from live CT 110 /usr/local/bin (2026-10-16).
# setup-input-dev.sh  (run as root)
# 1) Create /dev/input/event* nodes for Sunshine's virtual input devices.
# 2) Generate an Xorg config that attaches them (evdev) to X {{ steam_x_display }}.
# Sunshine creates its uinput devices at startup; their event nodes live on the
# host's devtmpfs. This container has no /dev/input bind-mount, so we create the
# nodes manually from /sys (matching major:minor) and point the X server at them.
set -u

CONF=/etc/X11/xorg.conf.d/99-sunshine-input.conf

mkdir -p /dev/input
chmod 755 /dev/input

mouse_raw=""     # relative "Mouse passthrough"
mouse_abs=""     # "Mouse passthrough (absolute)"
keyboard=""      # "Keyboard passthrough"
created=0

for event in /sys/class/input/event*; do
    [ -e "$event" ] || continue
    name="$(cat "$event/device/name" 2>/dev/null)"
    case "$name" in
        *passthrough*|*Xbox*|*Controller*|*gamepad*)
            ev="$(basename "$event")"
            dev="$(cat "$event/dev" 2>/dev/null)"   # e.g. "13:82"
            [ -n "$dev" ] || continue
            maj="${dev%%:*}"; min="${dev##*:}"
            rm -f "/dev/input/$ev"
            mknod "/dev/input/$ev" c "$maj" "$min"
            chmod 666 "/dev/input/$ev"
            echo "created /dev/input/$ev ($name) $maj:$min"
            created=$((created+1))
            case "$name" in
                *[Mm]ouse\ passthrough*) [ -z "$mouse_raw" ] && mouse_raw="/dev/input/$ev" ;;
                *[Mm]ouse\ passthrough*\(absolute\)*|*absolute*) [ -z "$mouse_abs" ] && mouse_abs="/dev/input/$ev" ;;
                *[Kk]eyboard\ passthrough*) [ -z "$keyboard" ] && keyboard="/dev/input/$ev" ;;
            esac
            ;;
    esac
done

# Prefer a relative mouse; fall back to the absolute one.
[ -n "$mouse_raw" ] || mouse_raw="$mouse_abs"

# Generate the Xorg input config. Identifiers must match the ServerLayout refs
# in 10-nvidia-virtual.conf ("Sunshine Mouse"/"Sunshine Keyboard").
{
    echo '# Auto-generated by setup-input-dev.sh - do not edit'
    echo 'Section "InputDevice"'
    echo '    Identifier "Sunshine Mouse"'
    echo '    Driver "evdev"'
    if [ -n "$mouse_raw" ]; then
        echo "    Option \"Device\" \"$mouse_raw\""
    else
        echo '    Option "Device" "/dev/input/nonexistent"'
    fi
    echo '    Option "CorePointer" "true"'
    echo 'EndSection'
    echo ''
    echo 'Section "InputDevice"'
    echo '    Identifier "Sunshine Keyboard"'
    echo '    Driver "evdev"'
    if [ -n "$keyboard" ]; then
        echo "    Option \"Device\" \"$keyboard\""
    else
        echo '    Option "Device" "/dev/input/nonexistent"'
    fi
    echo '    Option "CoreKeyboard" "true"'
    echo 'EndSection'
} > "$CONF"

echo "wrote $CONF (mouse=$mouse_raw keyboard=$keyboard, created=$created nodes)"
exit 0